# ======================================================
# MediBill Pro - Environment Configuration Template
# Placeholders only. DO NOT commit actual secrets here.
# ======================================================

# Environment Mode: development | test | staging | production
NODE_ENV="development"
PORT="3000"

# Public Application URLs (Safe to expose to browser client)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_ENABLE_ANALYTICS="false"

# Database Configuration (PostgreSQL / Prisma)
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/medibill_db?schema=public"

# Redis Cache & Background Queue Infrastructure (BullMQ)
REDIS_URL="redis://localhost:6379"

# Authentication & Session Security (Min 32 characters required)
SESSION_SECRET="YOUR_SECURE_SESSION_SECRET_MIN_32_CHARACTERS_LONG"
JWT_SECRET="YOUR_SECURE_JWT_SECRET_MIN_32_CHARACTERS_LONG"

# PHI Data at Rest Encryption Key (32-byte string/hex for AES-256)
ENCRYPTION_KEY="YOUR_SECURE_32_BYTE_ENCRYPTION_KEY_STRING"

# Storage Configuration (S3 / MinIO Encrypted PHI Documents)
S3_ENDPOINT="https://s3.amazonaws.com"
S3_BUCKET="medibill-phi-documents"
S3_ACCESS_KEY="YOUR_S3_ACCESS_KEY_ID"
S3_SECRET_KEY="YOUR_S3_SECRET_ACCESS_KEY"
S3_REGION="us-east-1"

# Email Configuration (SMTP)
SMTP_HOST="smtp.provider.com"
SMTP_PORT="587"
SMTP_USER="YOUR_SMTP_USERNAME"
SMTP_PASS="YOUR_SMTP_PASSWORD"
EMAIL_FROM="noreply@yourdomain.com"

# Payment Gateway Configuration (Stripe)
STRIPE_SECRET_KEY="YOUR_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="YOUR_STRIPE_WEBHOOK_SECRET"

# Healthcare & Clearinghouse Integrations (EDI 837 / 835 / 270 / 271)
CLEARINGHOUSE_API_KEY="YOUR_CLEARINGHOUSE_API_KEY"
CLEARINGHOUSE_API_URL="https://api.clearinghouse.com/v1"
ELIGIBILITY_API_KEY="YOUR_ELIGIBILITY_PAYER_API_KEY"

# CORS Security (Comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:3000"

# Logging Level: debug | info | warn | error
LOG_LEVEL="info"
